---
import type { T, Lang } from '../i18n';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import Work from './Work.astro';
import Footer from './Footer.astro';

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<main>
  <Hero t={t} lang={lang} />
  <Stack t={t} />
  <Work t={t} />
</main>
<Footer t={t} />
