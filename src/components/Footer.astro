---
import type { T } from '../i18n';

interface Props {
  t: T;
}
const { t } = Astro.props;
---

<footer class="footer" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="index mono" data-reveal id="contact-title">
      <span class="num">{t.footer.index}</span> / {t.footer.label}
    </p>

    <a class="email" href={`mailto:${t.footer.email}`} data-reveal style="--reveal-delay: 0.08s">
      {t.footer.email}
    </a>

    <div class="sig mono" data-reveal style="--reveal-delay: 0.14s">
      <p class="signature">
        <span class="pulse" aria-hidden="true"></span>
        {t.footer.signature}
      </p>
      <p class="colophon">{t.footer.colophon}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding: clamp(5rem, 12vw, 9rem) 0 3rem;
  }

  .index {
    color: var(--faint);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .index .num {
    color: var(--accent);
  }

  .email {
    display: inline-block;
    font-size: clamp(1.9rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    word-break: break-all;
    transition: color 0.35s var(--ease);
  }
  .email:hover {
    color: var(--accent);
  }

  .sig {
    margin-top: clamp(4rem, 9vw, 7rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .signature {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(61, 214, 140, 0.45); }
    70%, 100% { box-shadow: 0 0 0 8px rgba(61, 214, 140, 0); }
  }
  .colophon {
    color: var(--faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
