---
import type { T, Lang } from '../i18n';

interface Props {
  t: T;
  lang: Lang;
}
const { t, lang } = Astro.props;

const otherLang = lang === 'en' ? 'es' : 'en';
const otherHref = lang === 'en' ? '/es/' : '/';
---

<header class="hero">
  <nav class="wrap nav mono" aria-label="Main">
    <a href={lang === 'en' ? '/' : '/es/'} class="brand">{t.nav.brand}</a>
    <a href={otherHref} class="lang link">{otherLang}</a>
  </nav>

  <div class="wrap">
    <p class="status mono" data-reveal>
      <span class="pulse" aria-hidden="true"></span>
      {t.hero.status}
      <span class="sep" aria-hidden="true">/</span>
      {t.hero.location}
    </p>

    <h1 class="statement" data-reveal style="--reveal-delay: 0.08s">
      {t.hero.statement.map((line) => <span class="line">{line}</span>)}
    </h1>

    <div class="foot" data-reveal style="--reveal-delay: 0.18s">
      <p class="sub">{t.hero.sub}</p>
      <ul class="links mono">
        {
          t.hero.links.map(({ label, href }) => (
            <li>
              <a
                class="link"
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {label} <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding: 8rem 0 6rem;
  }

  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    color: var(--muted);
  }
  .brand {
    color: var(--text);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .sep {
    color: var(--faint);
  }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(61, 214, 140, 0.45); }
    70%, 100% { box-shadow: 0 0 0 8px rgba(61, 214, 140, 0); }
  }

  .statement {
    font-size: clamp(2.9rem, 9.5vw, 7.75rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .statement .line {
    display: block;
  }
  .statement .line:last-child {
    color: var(--muted);
  }

  .foot {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .sub {
    max-width: 42ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
  .arrow {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }
  .link:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
